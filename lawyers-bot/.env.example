BOT_TOKEN=123456:AAAA-your-telegram-bot-token
DATABASE_URL=postgres://lawyers_bot:lawyers_bot@localhost:5432/lawyers_bot
PORT=3000
ADMIN_IDS=111111111,222222222
SITE_URL=https://ns-zakona.ru
# Ссылка на политику обработки персональных данных (показывается перед вводом ФИО)
PRIVACY_URL=https://ns-zakona.ru/politika-konfidencialnosti
EMBLEM_PATH=assets/emblem.png
TZ_NAME=Europe/Moscow
LOG_LEVEL=info

# Сколько будущих записей может держать один клиент одновременно
MAX_ACTIVE_BOOKINGS=2

# Заполните, если бот работает через webhook (например, за reverse proxy с HTTPS).
# Если переменная не задана — бот работает в режиме long polling.
WEBHOOK_URL=
# Обязателен вместе с WEBHOOK_URL: случайная строка 32+ символов, например `openssl rand -hex 32`.
# Telegram присылает её в каждом запросе, всё остальное бот отбрасывает.
WEBHOOK_SECRET=
