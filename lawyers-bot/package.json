{
  "name": "lawyers-bot",
  "version": "1.0.0",
  "description": "Telegram-бот записи на консультацию для КА \"На стороне закона\"",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/database/migrations && cp src/database/migrations/*.sql dist/database/migrations/",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seeds/seed.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "grammy": "^1.27.0",
    "pg": "^8.12.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/jest": "^29.5.12",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0",
    "ts-jest": "^29.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "prettier": "^3.3.2"
  }
}
