# ── Часовой пояс коллегии ────────────────────────────────────────────
# Слоты приёма трактуются в этом поясе. Запускайте процесс с ним же.
TZ=Europe/Moscow

# ── PostgreSQL ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/nsz_bots

# ── Токены ботов ─────────────────────────────────────────────────────
# Telegram — получить у @BotFather
TELEGRAM_BOT_TOKEN=
# MAX — получить у @MasterBot внутри MAX
MAX_BOT_TOKEN=

# ── Почта: уведомления адвокатам о новых записях ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Коллегия «На стороне Закона» <noreply@na-storone-zakona.ru>"
# Куда адвокат ответит, если нажмёт «Ответить» (необязательно)
MAIL_REPLY_TO=

# ── Контакты адвокатов (попадают в БД при npm run db:seed) ───────────
# Почта — куда уходит письмо о новой записи.
ADVOCATE_SV_EMAIL=sv-bogdan@mail.ru
ADVOCATE_SV_TELEGRAM_ID=
ADVOCATE_SV_MAX_ID=

ADVOCATE_IN_EMAIL=in-bogdan@mail.ru
ADVOCATE_IN_TELEGRAM_ID=
ADVOCATE_IN_MAX_ID=
