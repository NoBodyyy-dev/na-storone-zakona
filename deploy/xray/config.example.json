{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": false }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "VPN_SERVER_HOST",
            "port": 443,
            "users": [{ "id": "VPN_USER_UUID", "encryption": "none", "flow": "xtls-rprx-vision" }]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "VPN_SNI",
          "fingerprint": "chrome",
          "publicKey": "VPN_PUBLIC_KEY",
          "shortId": "VPN_SHORT_ID"
        }
      }
    }
  ]
}
